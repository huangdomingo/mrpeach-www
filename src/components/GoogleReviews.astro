---
/**
 * GoogleReviews.astro
 * Build 時從 Google Places API 抓取評論，靜態嵌入頁面（對 SEO 最有利）
 */

const API_KEY = import.meta.env.GOOGLE_PLACES_API_KEY;
// GOOGLE_PLACE_ID 選填：若未設定，會自動用農場名稱搜尋
let PLACE_ID = import.meta.env.GOOGLE_PLACE_ID as string | undefined;

interface Review {
  rating: number;
  relativePublishTimeDescription: string;
  text?: { text: string };
  authorAttribution: {
    displayName: string;
    photoUri: string;
  };
  publishTime: string;
}

interface PlaceDetails {
  displayName: { text: string };
  rating: number;
  userRatingCount: number;
  reviews: Review[];
}

let placeDetails: PlaceDetails | null = null;

if (API_KEY) {
  try {
    // 若沒有 Place ID，用 Text Search 自動搜尋
    if (!PLACE_ID) {
      const findRes = await fetch(
        "https://places.googleapis.com/v1/places:searchText",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-Goog-Api-Key": API_KEY,
            "X-Goog-FieldMask": "places.id,places.displayName",
          },
          body: JSON.stringify({
            textQuery: "水蜜桃達人農場 拉拉山 桃園",
            languageCode: "zh-TW",
          }),
        }
      );
      const findData = await findRes.json();
      PLACE_ID = findData.places?.[0]?.id;
      if (PLACE_ID) {
        console.log(`[GoogleReviews] 找到 Place ID：${PLACE_ID}（建議存入 .env 的 GOOGLE_PLACE_ID 加速 build）`);
      } else {
        console.warn("[GoogleReviews] 找不到商家，請確認名稱或手動設定 GOOGLE_PLACE_ID");
      }
    }

    if (PLACE_ID) {
      const res = await fetch(
        `https://places.googleapis.com/v1/places/${PLACE_ID}`,
        {
          headers: {
            "X-Goog-Api-Key": API_KEY,
            "X-Goog-FieldMask": "displayName,rating,userRatingCount,reviews",
            "Accept-Language": "zh-TW",
          },
        }
      );
      const data = await res.json();
      if (data.displayName) {
        placeDetails = data;
      } else {
        console.warn("[GoogleReviews] Places API (New) 回傳異常：", JSON.stringify(data));
      }
    }
  } catch (e) {
    console.warn("[GoogleReviews] 無法取得評論：", e);
  }
}

// Places API (New) 預設回傳「最相關」排序，改按 publishTime 降冪（最新在前）
const reviews = (placeDetails?.reviews ?? []).sort(
  (a, b) => new Date(b.publishTime).getTime() - new Date(a.publishTime).getTime()
);
const avgRating = placeDetails?.rating ?? 0;
const totalCount = placeDetails?.userRatingCount ?? 0;

function renderStars(rating: number): string {
  return "★".repeat(Math.round(rating)) + "☆".repeat(5 - Math.round(rating));
}

// Schema.org 結構化資料（讓 Google 搜尋結果顯示星星評分）
const reviewsSchema = placeDetails ? {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "水蜜桃達人農場",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": avgRating.toFixed(1),
    "reviewCount": totalCount,
    "bestRating": "5",
    "worstRating": "1"
  },
  "review": reviews.slice(0, 5).map((r) => ({
    "@type": "Review",
    "author": {
      "@type": "Person",
      "name": r.authorAttribution.displayName
    },
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": r.rating,
      "bestRating": "5",
      "worstRating": "1"
    },
    "reviewBody": r.text?.text ?? "",
    "datePublished": r.publishTime.split("T")[0]
  }))
} : null;
---

{reviews.length > 0 && (
  <>
    {reviewsSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(reviewsSchema)} />
    )}

    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4">

        <!-- 標題區 -->
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-slate-900">顧客真實評價</h2>
          <div class="w-20 h-1.5 bg-pink-600 mx-auto mt-4 rounded-full"></div>
          <div class="mt-6 flex items-center justify-center gap-3">
            <span class="text-5xl font-black text-slate-900">{avgRating.toFixed(1)}</span>
            <div>
              <div class="text-yellow-400 text-2xl tracking-wide" aria-label={`${avgRating} 顆星`}>
                {renderStars(avgRating)}
              </div>
              <p class="text-sm text-slate-500 mt-1">共 {totalCount} 則 Google 評論</p>
            </div>
          </div>
        </div>

        <!-- 評論卡片 -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {reviews.slice(0, 6).map((review) => (
            <div class="bg-gray-50 rounded-2xl p-6 border border-slate-100 flex flex-col gap-3">
              <div class="flex items-center gap-3">
                <img
                  src={review.authorAttribution.photoUri}
                  alt={review.authorAttribution.displayName}
                  class="w-10 h-10 rounded-full object-cover"
                  loading="lazy"
                  width="40"
                  height="40"
                  referrerpolicy="no-referrer"
                />
                <div>
                  <p class="font-bold text-slate-800 text-sm">{review.authorAttribution.displayName}</p>
                  <p class="text-xs text-slate-400">{review.relativePublishTimeDescription}</p>
                </div>
              </div>
              <div class="text-yellow-400 text-lg" aria-label={`${review.rating} 顆星`}>
                {renderStars(review.rating)}
              </div>
              {review.text?.text && (
                <p class="text-slate-700 text-sm leading-relaxed line-clamp-4">{review.text.text}</p>
              )}
            </div>
          ))}
        </div>

        <!-- 查看更多連結 -->
        <div class="text-center mt-10">
          <a
            href="https://www.google.com/maps/place/水蜜桃達人農場/@24.6905126,121.405508,17z"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 border-2 border-slate-300 hover:border-pink-500 text-slate-600 hover:text-pink-600 px-8 py-3 rounded-full font-bold transition"
          >
            <svg class="w-5 h-5" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.1 7.9 3L37.1 9.7C33.6 6.4 29 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.6-.4-3.9z" fill="#FFC107"/>
              <path d="M6.3 14.7l6.6 4.8C14.5 16.1 19 13 24 13c3.1 0 5.8 1.1 7.9 3L37.1 9.7C33.6 6.4 29 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" fill="#FF3D00"/>
              <path d="M24 44c4.9 0 9.3-1.9 12.7-4.9l-5.9-5c-1.9 1.4-4.3 2.2-6.8 2.2-5.2 0-9.6-3.5-11.2-8.2L6.2 33.2C9.5 39.6 16.2 44 24 44z" fill="#4CAF50"/>
              <path d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.4l5.9 5c-.4.4 6.9-5 6.9-14.4 0-1.3-.1-2.6-.4-3.9z" fill="#1976D2"/>
            </svg>
            在 Google Maps 查看全部評論
          </a>
        </div>
      </div>
    </section>
  </>
)}
