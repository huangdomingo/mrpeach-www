---
// src/pages/pick-your-own.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

// ✅ 採果照片路徑請確認正確
import pickPhoto from "../assets/hero/pick-your-own.jpg";

const pageTitle = "拉拉山採水蜜桃體驗・預約｜水蜜桃達人農場";
const pageDescription = "拉拉山採水蜜桃體驗已於 2026 產季結束。位於桃園復興區上巴陵，明年產季再相見。";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-white">
    <div class="bg-amber-50 border-b border-amber-200 text-amber-800 py-4 px-4">
      <div class="max-w-7xl mx-auto text-center font-bold">
        ⚠️ 2026 水蜜桃產季已結束，採果體驗暫停開放，明年產季再見！
      </div>
    </div>
    <section class="bg-slate-900 text-white">
      <div
        class="max-w-7xl mx-auto px-6 pt-16 lg:pt-24 pb-12 grid lg:grid-cols-2 gap-12 items-center"
      >
        <div>
          <div
            class="inline-block bg-emerald-600 text-white px-4 py-1 rounded-full text-sm font-bold mb-6"
          >
            📍 桃園復興區・上巴陵
          </div>
          <h1 class="text-4xl lg:text-6xl font-black leading-tight">
            拉拉山採水蜜桃<br /><span class="text-pink-400">親手摘下</span>鮮甜
          </h1>

          <p class="text-white/80 mt-6 text-lg leading-relaxed max-w-xl">
            拉拉山水蜜桃季限定體驗！您可以現場走入果園，親自挑選並採摘碩大飽滿的水蜜桃，感受大地的回報。
            <br /><br />
            <span class="font-bold text-pink-300"
              >⚠️ 採果須知：採果當日請先電話預約；下雨天不開放（避免斜坡滑倒）。</span
            >
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="tel:+886975167080"
              class="bg-pink-600 hover:bg-pink-700 text-white px-8 py-4 rounded-full font-bold transition shadow-lg flex items-center gap-2"
            >
              📞 電話預約採果
            </a>

            <a
              href="https://line.me/ti/p/~0975167080"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-4 rounded-full font-bold transition shadow-lg flex items-center gap-2"
            >
              💬 一鍵加 LINE 詢問
            </a>

            <a
              href="https://www.google.com/maps/search/?api=1&query=拉拉山水蜜桃達人農場"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 px-8 py-4 rounded-full font-bold transition flex items-center gap-2"
            >
              📍 Google 導航
            </a>
          </div>

          <p class="mt-6 text-sm text-white/50">
            * 提醒：山區收訊不穩，建議先下載離線地圖。
          </p>
        </div>

        <div
          class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-sm"
        >
          <h2 class="text-2xl font-black text-pink-400 mb-6">採果重點摘要</h2>
          <ul class="space-y-4 text-white/90">
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>當日預約：</strong>0975-167-080 阿義老闆</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>入園費：</strong>每人 100 元（全額折抵消費）</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>秤重計價：</strong>一斤 300 元（大小顆均價）</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>穿著建議：</strong>請穿著運動鞋或防滑平底鞋</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-6 pb-20">
        <div
          class="rounded-3xl overflow-hidden shadow-2xl border border-white/10"
        >
          <Image
            src={pickPhoto}
            alt="拉拉山水蜜桃達人農場採果體驗實景"
            class="w-full h-[400px] lg:h-[550px] object-cover"
          />
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-black text-slate-900">
            簡單三步驟，展開採果行程
          </h2>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
          <div
            class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100 relative overflow-hidden group"
          >
            <div
              class="text-6xl font-black text-slate-100 absolute -top-2 -right-2 transition-colors group-hover:text-pink-50"
            >
              01
            </div>
            <h3 class="text-xl font-black text-slate-900 relative z-10 mb-4">
              電話確認天氣
            </h3>
            <p class="text-slate-600 relative z-10 leading-relaxed">
              山區天氣多變，出發當日請先致電 <b>0975-167-080</b
              >。若當天下雨為顧及安全將不開放採果。
            </p>
          </div>

          <div
            class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100 relative overflow-hidden group"
          >
            <div
              class="text-6xl font-black text-slate-100 absolute -top-2 -right-2 transition-colors group-hover:text-pink-50"
            >
              02
            </div>
            <h3 class="text-xl font-black text-slate-900 relative z-10 mb-4">
              導航至停車場
            </h3>
            <p class="text-slate-600 relative z-10 leading-relaxed">
              導航請設定「<b>拉拉山水蜜桃達人農場</b
              >」，我們位於上巴陵地區。請依照指示停妥車輛。
            </p>
          </div>

          <div
            class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100 relative overflow-hidden group"
          >
            <div
              class="text-6xl font-black text-slate-100 absolute -top-2 -right-2 transition-colors group-hover:text-pink-50"
            >
              03
            </div>
            <h3 class="text-xl font-black text-slate-900 relative z-10 mb-4">
              向阿義報到
            </h3>
            <p class="text-slate-600 relative z-10 leading-relaxed">
              停好車後步行約 10 公尺即可抵達農場。請認明「水蜜桃達人農場」找 <b
                >阿義老闆</b
              > 領取採果籃。
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-6">
        <div
          class="bg-slate-900 rounded-[3rem] p-10 lg:p-16 text-white text-center shadow-2xl"
        >
          <h2 class="text-3xl font-black mb-8">費用與計價</h2>
          <div class="grid md:grid-cols-2 gap-10">
            <div
              class="border-b md:border-b-0 md:border-r border-white/10 pb-10 md:pb-0 md:pr-10"
            >
              <div class="text-pink-400 text-5xl font-black mb-4">
                100<span class="text-xl">元</span>
              </div>
              <h3 class="text-xl font-bold mb-3">入園清潔費</h3>
              <p class="text-white/60 text-sm">
                每人入園收費，贈送 100 元折價券<br />可全額抵扣當日水蜜桃消費
              </p>
            </div>
            <div>
              <div class="text-emerald-400 text-5xl font-black mb-4">
                300<span class="text-xl">元</span>
              </div>
              <h3 class="text-xl font-bold mb-3">採果秤重 (斤)</h3>
              <p class="text-white/60 text-sm">
                親手採摘之水蜜桃現場秤重計價<br />大小顆均一價，感受親採樂趣
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
