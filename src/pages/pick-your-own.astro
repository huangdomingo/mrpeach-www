---
// src/pages/pick-your-own.astro
// 採果體驗入口頁：水蜜桃產季已結束，當季請看甜柿採果專頁
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

import pickPhoto from "../assets/hero/pick-your-own.jpg";

const pageTitle = "拉拉山採果體驗｜水蜜桃產季已結束・甜柿採果開放中";
const pageDescription =
  "拉拉山水蜜桃採果 2026 產季已結束。目前開放的是甜柿採果，位於桃園復興區上巴陵，歡迎來電 0975-167-080 預約。";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="bg-white">
    <div class="bg-amber-500 text-white py-4 px-4">
      <div class="max-w-7xl mx-auto text-center font-bold text-sm sm:text-base">
        🍊 甜柿採果開放中！水蜜桃採果產季已結束，歡迎前往甜柿採果專頁
      </div>
    </div>

    <section class="bg-slate-900 text-white">
      <div
        class="max-w-7xl mx-auto px-6 pt-16 lg:pt-24 pb-16 grid lg:grid-cols-2 gap-12 items-center"
      >
        <div>
          <div
            class="inline-block bg-emerald-600 text-white px-4 py-1 rounded-full text-sm font-bold mb-6"
          >
            📍 桃園復興區・上巴陵
          </div>
          <h1 class="text-4xl lg:text-6xl font-black leading-tight">
            拉拉山採果體驗
          </h1>

          <p class="text-white/80 mt-6 text-lg leading-relaxed max-w-xl">
            <span class="font-bold text-amber-300"
              >🍑 2026 水蜜桃採果產季已結束</span
            >，感謝大家的支持，明年產季再相見。<br /><br />
            現在開放的季節性採果是 <span class="font-bold text-amber-300"
              >🍊 專業甜柿</span
            >——可以連皮吃、比市面上甜、不甜可以退貨。
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="/persimmon-picking"
              class="bg-amber-500 hover:bg-amber-600 text-white px-8 py-4 rounded-full font-bold transition shadow-lg flex items-center gap-2"
            >
              🍊 前往甜柿採果專頁
            </a>
            <a
              href="tel:+886975167080"
              class="bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 px-8 py-4 rounded-full font-bold transition flex items-center gap-2"
            >
              📞 0975-167-080
            </a>
            <a
              href="https://line.me/ti/p/~0975167080"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-4 rounded-full font-bold transition shadow-lg flex items-center gap-2"
            >
              💬 一鍵加 LINE
            </a>
          </div>
        </div>

        <div
          class="bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-sm lg:order-last"
        >
          <h2 class="text-2xl font-black text-amber-400 mb-6">採果重點摘要</h2>
          <ul class="space-y-4 text-white/90">
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>當季開放：</strong>專業甜柿（水蜜桃已結束）</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>當日預約：</strong>0975-167-080 阿義老闆</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>入園與計價：</strong>請來電或 LINE 洽詢當季收費</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-emerald-500">✔</span>
              <span><strong>穿著建議：</strong>請穿著運動鞋或防滑平底鞋</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-6 pb-20">
        <div class="rounded-3xl overflow-hidden shadow-2xl border border-white/10">
          <Image
            src={pickPhoto}
            alt="拉拉山水蜜桃達人農場採果體驗實景"
            class="w-full h-[400px] lg:h-[550px] object-cover"
          />
        </div>
      </div>
    </section>

    <section class="py-20 bg-amber-50">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-3xl lg:text-4xl font-black text-slate-900 mb-4">
          現在開放：甜柿採果 🍊
        </h2>
        <p class="text-slate-600 mb-10">
          專業甜柿產季開跑，可以連皮吃、比市面上甜、不甜可以退貨。
        </p>
        <a
          href="/persimmon-picking"
          class="inline-block bg-amber-500 hover:bg-amber-600 text-white px-10 py-4 rounded-full font-black transition shadow-xl"
        >
          看甜柿採果資訊與預約 →
        </a>
      </div>
    </section>

    <section class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-16">
          <h2 class="text-3xl lg:text-4xl font-black text-slate-900">
            採果怎麼去？三步驟
          </h2>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
          <div
            class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100 relative overflow-hidden"
          >
            <div class="text-6xl font-black text-slate-100 absolute -top-2 -right-2">
              01
            </div>
            <h3 class="text-xl font-black text-slate-900 relative z-10 mb-4">
              電話確認天氣
            </h3>
            <p class="text-slate-600 relative z-10 leading-relaxed">
              山區天氣多變，出發當日請先致電 <b>0975-167-080</b
              >。若當天下雨為顧及安全將不開放採果。
            </p>
          </div>

          <div
            class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100 relative overflow-hidden"
          >
            <div class="text-6xl font-black text-slate-100 absolute -top-2 -right-2">
              02
            </div>
            <h3 class="text-xl font-black text-slate-900 relative z-10 mb-4">
              導航至停車場
            </h3>
            <p class="text-slate-600 relative z-10 leading-relaxed">
              導航請設定「<b>拉拉山水蜜桃達人農場</b
              >」，我們位於上巴陵地區。請依照指示停妥車輛。
            </p>
          </div>

          <div
            class="bg-white rounded-3xl p-8 shadow-sm border border-slate-100 relative overflow-hidden"
          >
            <div class="text-6xl font-black text-slate-100 absolute -top-2 -right-2">
              03
            </div>
            <h3 class="text-xl font-black text-slate-900 relative z-10 mb-4">
              向阿義報到
            </h3>
            <p class="text-slate-600 relative z-10 leading-relaxed">
              停好車後步行約 10 公尺即可抵達農場。請認明「水蜜桃達人農場」找 <b
                >阿義老闆</b
              > 領取採果籃。
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
