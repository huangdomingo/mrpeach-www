---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";

export async function getStaticPaths() {
  const products = (await getCollection("products")).filter(
    (post) => post.data.isAvailable !== false,
  );
  return products.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 取得商品圖的完整 URL，供 OG 標籤使用（無圖時退回全站預設圖）
const ogImageUrl = post.data.image
  ? new URL(
      (
        await getImage({ src: post.data.image, width: 1200, height: 630 })
      ).src,
      Astro.site,
    ).href
  : `${Astro.site}og-image.jpg`;

// 商品 description：結合規格與原有描述文字
const ogDescription = `${post.data.spec}｜拉拉山上巴陵專業甜柿，可以連皮吃、不甜可以退貨、產地直送。${post.data.description}`;
---

<BaseLayout
  title={`${post.data.title}｜水蜜桃達人農場`}
  description={ogDescription}
  ogImage={ogImageUrl}
  ogType="product"
>
  <article class="py-12 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-12 mb-20">
        <div
          class="rounded-3xl overflow-hidden shadow-2xl border border-gray-100"
        >
          {post.data.image ? (
            <Image
              src={post.data.image}
              alt={post.data.title}
              class="w-full h-auto object-cover"
            />
          ) : (
            <div class="aspect-square flex items-center justify-center bg-linear-to-br from-amber-50 to-orange-100 text-[10rem]">
              {post.data.imageEmoji}
            </div>
          )}
        </div>

        <div class="flex flex-col">
          <nav class="flex mb-6 text-sm text-gray-500">
            <a href="/products" class="hover:text-pink-600">商品導購</a>
            <span class="mx-2">/</span>
            <span class="text-gray-900 font-medium">{post.data.title}</span>
          </nav>

          <h1 class="text-3xl lg:text-4xl font-bold text-slate-900 mb-4">
            {post.data.title}
          </h1>
          <div class="flex items-baseline gap-4 mb-6">
            <span class="text-3xl font-black text-pink-600"
              >NT$ {post.data.price}</span
            >
            <span class="text-slate-500 text-sm">{post.data.spec}</span>
          </div>

          <div
            class="bg-emerald-50 border border-emerald-100 p-5 rounded-2xl mb-6"
          >
            <p class="text-emerald-900 text-sm font-bold mb-2">
              🍊 我們的甜柿
            </p>
            <ul class="text-emerald-800 text-sm space-y-1">
              <li>✔ 甜柿可以連皮吃，比市面上的甜柿更甜</li>
              <li>✔ 保證甜，不甜退錢（NG 商品恕不退換）</li>
              <li>✔ 拉拉山上巴陵高海拔產地直送</li>
            </ul>
          </div>

          <div
            class="bg-amber-50 border border-amber-100 p-5 rounded-2xl mb-8"
          >
            <p class="text-amber-900 text-sm font-bold mb-3">
              🚚 冷藏宅配運費
            </p>
            <ul class="text-amber-800 text-sm space-y-1">
              <li><b>甜柿</b>：1 盒 150 元｜2~3 盒 225 元｜4~5 盒 290 元｜<b>6 盒免運</b></li>
              <li><b>馥梨・蘋果・水蜜桃乾</b>：1 盒 150 元｜2~3 盒 225 元｜4~7 盒 290 元｜<b>8 盒免運</b></li>
            </ul>
            <p class="text-amber-700 text-xs mt-3">
              運費依同一次寄送的總盒數合併計算；免運費以單一件（同一收件地址）為限。
            </p>
          </div>

          <div
            class="prose prose-pink prose-sm sm:prose-base mb-10 text-slate-600"
          >
            <Content />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a
              href="https://line.me/ti/p/~0975167080"
              target="_blank"
              class="bg-[#06C755] text-white py-4 rounded-full font-bold hover:bg-[#05b34c] transition shadow-lg flex items-center justify-center gap-2"
            >
              <span>透過 Line 訂購</span>
            </a>
            <a
              href="tel:0975167080"
              class="bg-slate-900 text-white py-4 rounded-full font-bold hover:bg-slate-800 transition shadow-lg flex items-center justify-center gap-2"
            >
              <span>電話訂購：阿義老闆</span>
            </a>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-3 gap-8 border-t border-slate-100 pt-16">
        <div class="lg:col-span-2">
          <h3
            class="text-2xl font-bold text-slate-900 mb-8 flex items-center gap-2"
          >
            <span
              class="w-8 h-8 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center text-sm"
              >1</span
            >
            訂購方式與流程
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-5 gap-4 text-center">
            {
              [
                { step: "聯繫訂購", icon: "📞" },
                { step: "確認訂單", icon: "✅" },
                { step: "完成付款", icon: "💰" },
                { step: "冷藏宅配", icon: "🚚" },
                { step: "鮮甜到府", icon: "🍊" },
              ].map((item, index) => (
                <div class="relative p-4">
                  <div class="text-3xl mb-2">{item.icon}</div>
                  <p class="text-sm font-bold text-slate-700">{item.step}</p>
                  {index < 4 && (
                    <div class="hidden md:block absolute top-1/2 -right-2 text-slate-300">
                      →
                    </div>
                  )}
                </div>
              ))
            }
          </div>
          <p
            class="mt-6 text-sm text-slate-500 bg-slate-50 p-4 rounded-xl italic"
          >
            付款方式：支援 ATM 轉帳、貨到付款（宅配公司代收）。
          </p>
        </div>

        <div>
          <h3
            class="text-2xl font-bold text-slate-900 mb-8 flex items-center gap-2"
          >
            <span
              class="w-8 h-8 bg-pink-100 text-pink-600 rounded-full flex items-center justify-center text-sm"
              >2</span
            >
            訂購前須知
          </h3>
          <ul class="space-y-4 text-sm text-slate-600">
            <li class="flex items-start gap-2">
              <span class="text-pink-500">●</span>
              甜柿<b>可以連皮一起吃</b>，清洗後即可享用。
            </li>
            <li class="flex items-start gap-2">
              <span class="text-pink-500">●</span>
              宅配以冷藏寄送，收到後請置於陰涼通風處或冷藏保存。
            </li>
            <li class="flex items-start gap-2">
              <span class="text-pink-500">●</span>
              <b>不甜可以退貨</b>；NG 惜福商品恕不退換貨。
            </li>
            <li class="flex items-start gap-2">
              <span class="text-pink-500">●</span>
              收到後請開箱檢查，若有異常請於當日聯繫我們，超過當日恕無法補償。
            </li>
          </ul>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
