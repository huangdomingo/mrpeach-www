---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

// 1. 引入關鍵視覺圖
import heroOwner from "../assets/hero/hero-peach-orchard.jpg";
import logoImage from "../assets/lalashan-mrpeach-logo.png";

// 2. 抓取商品與日記資料
const products = (await getCollection("products"))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const latestDiary = (await getCollection("diary")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
)[0];

const pageTitle = "水蜜桃達人農場｜榮獲2025拉拉山水蜜桃王・高海拔產地直送";

// 3. LocalBusiness 結構化資料（取代舊的 AgricultureService）
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Farm"],
  "name": "水蜜桃達人農場",
  "alternateName": "拉拉山水蜜桃達人",
  "description": "位於拉拉山上巴陵，海拔1,200至1,600公尺的高山水蜜桃農場。傳承三十年種植技術，榮獲2025年拉拉山水蜜桃王。每年五月至八月產季期間提供產地直送宅配與採果體驗。",
  "award": "2025 拉拉山水蜜桃王",
  "url": "https://www.mrpeach.com.tw",
  "telephone": "+886-934-195-496",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "華陵村135-7號",
    "addressLocality": "復興區",
    "addressRegion": "桃園市",
    "postalCode": "336",
    "addressCountry": "TW"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
    ],
    "opens": "08:00",
    "closes": "20:00",
    "validFrom": "2025-05-01",
    "validThrough": "2025-08-31"
  },
  "hasMap": "https://www.google.com/maps/search/?api=1&query=桃園市復興區華陵村135-7號",
  "image": "https://www.mrpeach.com.tw/og-image.jpg",
  "priceRange": "$$",
  "currenciesAccepted": "TWD",
  "paymentAccepted": "ATM Transfer, Cash on Delivery"
};

// 4. 媒體報導資料
const mediaReports = [
  {
    title: "桃園復興拉拉山水蜜桃開採 買正宗高品質認明產地標章",
    date: "2025/07/11",
    source: "自由時報",
    url: "https://news.ltn.com.tw/news/life/breakingnews/5106844",
    icon: "📰"
  },
  {
    title: "114年度復興區水蜜桃評選結果揭曉 周峻儀勇奪水蜜桃王",
    date: "2025/07/10",
    source: "桃園電子報",
    url: "https://tyenews.com/2025/07/903380/",
    icon: "🥇"
  },
  {
    title: "拉拉山水蜜桃達人：果農周峻儀的土地關懷與心路歷程",
    date: "2024/08/15",
    source: "PeoPo 公民新聞",
    url: "https://www.peopo.org/news/814641/",
    icon: "🎥"
  }
];
---

<BaseLayout title={pageTitle}>
  <!-- LocalBusiness 結構化資料 -->
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(localBusinessSchema)}
  />
  <section
    class="relative w-full min-h-[600px] lg:h-[90vh] flex items-center overflow-hidden bg-slate-900"
  >
    <div class="absolute inset-0 z-0">
      <Image
        src={heroOwner}
        alt="水蜜桃達人阿義老闆"
        class="w-full h-full object-cover object-center lg:object-right opacity-80"
      />
      <div
        class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"
      >
      </div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="max-w-2xl text-white">
        <div
          class="inline-block bg-pink-600 text-white px-6 py-2 rounded-full text-lg font-bold animate-bounce shadow-xl mb-6"
        >
          🏆 榮獲 拉拉山「水蜜桃王」最高殊榮
        </div>

        <h1
          class="text-4xl lg:text-6xl font-black mb-6 leading-tight tracking-tight"
        >
          傳承三十年<br /><span class="text-pink-400">拉拉山</span>鮮甜滋味
        </h1>

        <p
          class="text-lg lg:text-xl text-gray-200 mb-10 leading-relaxed max-w-lg"
        >
          海拔 1500 公尺的堅持。阿義老闆每日清晨 6:30
          鮮採，只為將最好的「水蜜桃王」品質送到您手中。
        </p>

        <div class="flex flex-wrap gap-4">
          <a
            href="/products"
            class="bg-pink-600 hover:bg-pink-700 text-white px-10 py-4 rounded-full font-bold text-lg transition shadow-lg"
          >
            立即選購禮盒
          </a>
          <a
            href="/pick-your-own"
            class="bg-emerald-600 hover:bg-emerald-700 text-white px-10 py-4 rounded-full font-bold text-lg transition shadow-lg"
          >
            預約採果
          </a>
          <a
            href="/about-orchard"
            class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 px-10 py-4 rounded-full font-bold text-lg transition"
          >
            了解果園故事
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-white border-b border-gray-50">
    <div
      class="max-w-7xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-8 text-center"
    >
      <div>
        <div class="text-3xl mb-2">🥇</div>
        <div class="font-bold text-slate-900">2025 水蜜桃王</div>
      </div>
      <div>
        <div class="text-3xl mb-2">💧</div>
        <div class="font-bold text-slate-900">2025 甜度王</div>
      </div>
      <div>
        <div class="text-3xl mb-2">⛰️</div>
        <div class="font-bold text-slate-900">1500M 高海拔</div>
      </div>
      <div>
        <div class="text-3xl mb-2">🚚</div>
        <div class="font-bold text-slate-900">全程冷藏宅配</div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex justify-between items-end mb-12">
        <div>
          <h2 class="text-3xl font-bold text-slate-900">當季限定禮盒</h2>
          <p class="text-slate-500 mt-2">每一顆都是果園產地直送的驕傲</p>
        </div>
        <a href="/products" class="text-pink-600 font-bold hover:underline"
          >查看全部規格 →</a
        >
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          products.map((product) => (
            <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden flex flex-col hover:shadow-xl transition-all">
              <div class="aspect-square overflow-hidden bg-gray-100">
                <Image
                  src={product.data.image}
                  alt={product.data.title}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-8">
                <h3 class="text-xl font-bold text-slate-900 mb-2">
                  {product.data.title}
                </h3>
                <p class="text-pink-600 font-bold mb-4 text-sm">
                  {product.data.spec}
                </p>
                <div class="flex justify-between items-center mt-6 pt-6 border-t border-slate-50">
                  <span class="text-2xl font-black text-slate-900">
                    NT$ {product.data.price}
                  </span>
                  <a
                    href={`/products/${product.slug}`}
                    class="bg-pink-600 text-white px-4 py-2 rounded-full text-xs font-bold"
                  >
                    查看細節
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-slate-900 mb-16">
        簡單五步驟，鮮甜送到家
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {
          [
            { step: "聯繫訂購", icon: "📞" },
            { step: "確認訂單", icon: "✅" },
            { step: "完成付款", icon: "💰" },
            { step: "冷藏宅配", icon: "🚚" },
            { step: "交易完成", icon: "桃" },
          ].map((item, index) => (
            <div class="relative">
              <div class="w-16 h-16 bg-pink-50 text-pink-600 rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-inner">
                {item.icon}
              </div>
              <p class="font-bold text-slate-700">{item.step}</p>
              {index < 4 && (
                <div class="hidden md:block absolute top-8 -right-4 text-slate-200">
                  →
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900">媒體實績與得獎見證</h2>
        <div class="w-20 h-1.5 bg-pink-600 mx-auto mt-4 rounded-full"></div>
        <p class="text-slate-500 mt-6 text-lg">
          高品質的正宗拉拉山水蜜桃，深受各大媒體肯定與報導
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          mediaReports.map((report) => (
            <a 
              href={report.url} 
              target="_blank" 
              rel="noopener noreferrer"
              class="group bg-white p-8 rounded-3xl shadow-sm border border-slate-100 hover:shadow-xl hover:-translate-y-1 transition-all"
            >
              <div class="flex justify-between items-start mb-6">
                <span class="text-4xl">{report.icon}</span>
                <span class="bg-slate-100 text-slate-500 text-xs px-3 py-1 rounded-full font-bold">
                  {report.date}
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 mb-4 group-hover:text-pink-600 transition-colors leading-snug">
                {report.title}
              </h3>
              <div class="flex items-center text-sm text-slate-500 font-bold">
                <span class="text-pink-600 mr-2">●</span>
                {report.source}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    latestDiary && (
      <section class="py-20 bg-pink-600 text-white">
        <div class="max-w-5xl mx-auto px-4 text-center">
          <span class="text-pink-200 font-bold tracking-widest text-sm uppercase">
            最新產地日記
          </span>
          <h2 class="text-2xl lg:text-3xl font-bold mt-4 mb-8 leading-relaxed italic">
            「{latestDiary.data.description}」
          </h2>
          <a
            href={`/diary/${latestDiary.slug}`}
            class="inline-block border-2 border-white/50 hover:bg-white hover:text-pink-600 px-8 py-3 rounded-full font-bold transition"
          >
            閱讀阿義老闆完整心情回顧
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
